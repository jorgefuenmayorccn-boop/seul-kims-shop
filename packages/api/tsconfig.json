{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESM",
    "lib": ["ES2020"],
    "moduleResolution": "nodenext",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
