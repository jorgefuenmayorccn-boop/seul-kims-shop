{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next",
      "config": { "zeroConfig": true }
    },
    {
      "src": "apps/cerebro/package.json",
      "use": "@vercel/next",
      "config": { "zeroConfig": true }
    },
    {
      "src": "apps/pos/package.json",
      "use": "@vercel/next",
      "config": { "zeroConfig": true }
    },
    {
      "src": "apps/repartidor/package.json",
      "use": "@vercel/next",
      "config": { "zeroConfig": true }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ]
}
